# Copy to deploy/deploy.env (gitignored) and adjust. No secrets here — the API's secrets
# live on the server (systemd unit / appsettings) and are never touched by deploy.sh.

# SSH target for the EC2 instance.
DEPLOY_HOST=ubuntu@35.154.189.207

# Path to the EC2 SSH private key on this machine. Never commit the key itself.
DEPLOY_SSH_KEY=../EC2/stonehub-key.pem

# Public HTTPS base URL (Caddy) used for the post-deploy smoke check.
DEPLOY_PUBLIC_URL=https://35-154-189-207.sslip.io
